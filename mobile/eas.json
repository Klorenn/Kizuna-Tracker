{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "base": {
      "credentialsSource": "local",
      "android": { "buildType": "apk" }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview"
    },
    "dev-preview": {
      "extends": "preview",
      "distribution": "internal",
      "credentialsSource": "remote",
      "android": { "buildType": "apk" },
      "env": { "APP_VARIANT": "dev" }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "credentialsSource": "local",
      "android": { "buildType": "apk" }
    }
  }
}
