<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kz_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/kz_widget_today"
            android:textColor="@color/kz_widget_ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2/5"
            android:textColor="@color/kz_widget_accent"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText"
            xmlns:tools="http://schemas.android.com/tools" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="10dp"
        android:drawableStart="@drawable/kz_check_empty"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:text="Meditar"
        android:textColor="@color/kz_widget_ink"
        android:textSize="15sp"
        tools:ignore="HardcodedText"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="10dp"
        android:drawableStart="@drawable/kz_check_empty"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:text="Estirar"
        android:textColor="@color/kz_widget_ink"
        android:textSize="15sp"
        tools:ignore="HardcodedText"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="+1 más"
        android:textColor="@color/kz_widget_muted"
        android:textSize="13sp"
        tools:ignore="HardcodedText"
        xmlns:tools="http://schemas.android.com/tools" />
</LinearLayout>
